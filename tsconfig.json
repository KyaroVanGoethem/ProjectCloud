{
  "compilerOptions": {
    "target": "ES2022",                       
    "module": "NodeNext",                  
    "moduleResolution": "NodeNext",
    "outDir": "./dist",                      
    "rootDir": "./",                          
    
    /* Strictheid & Kwaliteit */
    "strict": true,                            
    "noImplicitAny": true,                   
    "strictNullChecks": true,                 
    
    /* Compatibiliteit */
    "esModuleInterop": true,                     
    "skipLibCheck": true,                     
    "forceConsistentCasingInFileNames": true    
  },
  "include": ["**/*.ts"],                      
  "exclude": ["node_modules", "dist"]          
}
